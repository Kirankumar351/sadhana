########################################
# Application
########################################
APP_NAME=Sadhana
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laravel Debugbar: the panel along the bottom of every page. Dev-only (require-dev).
# Set to true when you need query/view timings; never enable in production.
DEBUGBAR_ENABLED=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# Telugu-first. `te` is the default locale, not a fallback.
APP_LOCALE=te
APP_FALLBACK_LOCALE=en

########################################
# Database
########################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sadhana
DB_USERNAME=sadhana
DB_PASSWORD=

########################################
# Cache, queue, session, streaks
########################################
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

########################################
# Keyword search — one index per locale.
# Telugu tokenisation differs fundamentally from English; a shared index makes
# relevance scoring incoherent for both.
########################################
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

########################################
# Object storage — Cloudflare R2.
# Zero egress fees. PDF downloads at our volume would bankrupt us on S3.
########################################
FILESYSTEM_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sadhana
R2_ENDPOINT=
R2_URL=https://cdn.sadhana.study

########################################
# Push and messaging
########################################
FCM_SERVER_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

########################################
# AI
########################################
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

AI_MODEL_SMALL=claude-haiku-4-5
AI_MODEL_LARGE=claude-sonnet-5
AI_MODEL_EMBEDDING=voyage-3

# Hard monthly ceiling in paise. The free product only works if AI cost stays
# under Rs 0.40 per active user per month.
AI_MONTHLY_CEILING_PAISE=5000000

########################################
# Vector store — Qdrant.
#
# NOTE: the source design documents specify a MySQL VECTOR(1536) column. MySQL 8
# has no vector type (that arrived in MySQL 9), so vectors live in Qdrant and
# `ai_chunks` stays the MySQL owner of record, joined by ai_chunks.id.
########################################
AI_VECTOR_DRIVER=qdrant
QDRANT_HOST=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sadhana_chunks

########################################
# Agents
#
# Ships OFF. Turning an agent on is a deliberate operational decision, and
# `php artisan agents:eval` should pass before you do it.
########################################
AGENTS_ENABLED=false
AGENT_RUNTIME=php
AGENTS_DAILY_CEILING_PAISE=200000
AI_SERVICE_URL=http://127.0.0.1:8100
AI_SERVICE_TOKEN=

########################################
# Commerce
#
# COMMERCE_GATES_OPEN=true means the payment machinery is live but nothing is
# actually withheld. Purchases still grant entitlements, so the data is already
# correct on the day a gate closes. See docs/04-COMMERCE.md before changing this.
########################################
COMMERCE_GATES_OPEN=true
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GST_ENABLED=false
GST_RATE=18.0
GST_HOME_STATE=TS
COMPANY_GSTIN=
INVOICE_PREFIX=SDH

########################################
# CDN / WAF
########################################
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

########################################
# Monitoring — alerts go to a phone, not an inbox.
# We find out before the student does.
########################################
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OPS_EMAIL=
OPS_PHONE=

# Poppler pdftotext reads notification PDFs page by page. Linux: install poppler-utils
# and leave this as is. Windows: the full path to pdftotext.exe.
PDFTOTEXT_PATH=pdftotext
