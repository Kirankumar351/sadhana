{
    "name": "sadhana/web",
    "type": "project",
    "description": "Sadhana — Telugu-first portal for Indian government and private job aspirants",
    "keywords": ["laravel", "livewire", "filament", "telugu", "edtech"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "livewire/livewire": "^3.5",
        "filament/filament": "^3.2",
        "spatie/laravel-translatable": "^6.7",
        "laravel/scout": "^10.0",
        "meilisearch/meilisearch-php": "^1.8",
        "spatie/laravel-sitemap": "^7.2",
        "spatie/laravel-backup": "^9.0",
        "intervention/image": "^3.6",
        "smalot/pdfparser": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.0",
        "sentry/sentry-laravel": "^4.6",
        "propaganistas/laravel-phone": "^5.3",
        "razorpay/razorpay": "^2.9",
        "guzzlehttp/guzzle": "^7.9",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "laravel/pint": "^1.17",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "barryvdh/laravel-debugbar": "^3.13",
        "laravel/pail": "^1.1",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "pest --parallel",
        "test:coverage": "pest --coverage --min=70",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
